# orrery 的环境变量一览（说明用的示例文件）。
#
# 没有任何程序会自动读取这个文件或 .env：要生效，必须把变量设进启动 Hub 的进程环境
# （PowerShell：$env:ORRERY_PORT = '4318'；cmd：set ORRERY_PORT=4318；或者 Windows 的用户环境变量）。
# 想留一份自己的值，可以复制成 .env（已被 .gitignore 忽略）；真实的令牌、密钥只能放在那里，绝不提交。
# 下面都注释掉了，等于默认值；空值也按"不设"处理。详细说明见 README.md 的环境变量表。

# --- Hub ---
# 监听端口（只监听 127.0.0.1）；0 表示随机空闲端口
# ORRERY_PORT=4317
# SQLite 数据库文件；旁边的 -wal、-shm 文件也属于它，不要放在云同步或网络文件夹里
# ORRERY_DB=.tmp/orrery.db
# 数据库的日志模式：wal（默认）或 delete（旧的回滚日志模式，已是 WAL 的数据库会切回来）；别的值 Hub 不启动
# ORRERY_DB_JOURNAL=wal
# 桥密钥 secret、API 令牌 api-token、hub.json、附件 files/ 和发件箱 outbox/ 所在目录（默认用户主目录下的 .orrery）
# ORRERY_HOME=
# 同一账户的共享接入登记处（默认 ~/.orrery/registry）；开发和测试要设独立目录
# ORRERY_REGISTRY=
# 1 以第二实例启动，默认禁止原生投递
# ORRERY_SECONDARY=
# 网页接口的 API 令牌，至少 32 个 A-Z a-z 0-9 . _ ~ - 字符；不设时 Hub 生成一个存在 <ORRERY_HOME>/api-token
# ORRERY_API_TOKEN=
# 一条消息链的最大跳数；只在网页上没保存过跳数上限时生效
# ORRERY_MAX_HOPS=6
# 一条消息链累计最多开始的轮次；只在网页上没保存过每条链轮次上限时生效
# ORRERY_MAX_TURNS_PER_CHAIN=20
# 每个对话每小时最多开始的轮次（普通成员）
# ORRERY_MAX_TURNS_PER_HOUR=30
# 作为当前启用的协调员被调度时，每小时最多开始的轮次
# ORRERY_MAX_COORDINATOR_TURNS_PER_HOUR=120
# 每个对话每小时最多开始的"一批全是系统通知"的批次数
# ORRERY_MAX_NOTICE_BATCHES_PER_HOUR=300
# 一条投递排队多少分钟还没开始就预警一次；0 关闭
# ORRERY_QUEUE_WARN_MINUTES=5
# 要禁用的官方插件 id，逗号分隔，优先于设置页的开关；写了不存在的 id 时 Hub 不启动
# ORRERY_DISABLED_PLUGINS=
# 输入框 $ 补全列出的 skill 文件夹（默认用户主目录下的 .agents/skills）
# ORRERY_SKILLS_DIR=
# 设为 1 时多注册一个测试用的 mock harness（不调用任何模型）
# ORRERY_MOCK=
# 原生 Codex 用的 codex 程序路径；不设时用桌面应用自带的，找不到再用 PATH 上的 codex
# ORRERY_CODEX_NATIVE_BIN=

# 设为 0 时当前 Hub 进程停止自动检查公开发行信息；设置页仍可手动检查
# ORRERY_UPDATE_CHECKS=0

# --- 只给测试用 ---
# 测试专用，不安全：off 时提交不等写到磁盘，断电会丢数据甚至损坏数据库。只由 test/helpers.ts 给测试 Hub 设，
# 不要在自己的 Hub 上设。不设或 full 是产品的设置
# ORRERY_TEST_DB_SYNC=off
# npm test 排队等待的上限（毫秒）
# ORRERY_TEST_QUEUE_TIMEOUT_MS=900000
# 设为 1 时 npm test 跳过本机排队
# ORRERY_TEST_NO_QUEUE=
# 设为 1 时 npm test 在屏幕上显示完整的测试输出
# ORRERY_TEST_VERBOSE=
# 设为 1 时不删测试临时目录
# ORRERY_KEEP_TEST_TEMP=
# 浏览器冒烟测试用的浏览器程序路径（任何 Chromium 内核的浏览器）
# ORRERY_TEST_BROWSER=
# 测试浏览器的配置槽位目录；不设时用系统临时目录下的 orrery-browser-slots
# ORRERY_TEST_BROWSER_SLOTS=
# 设为 1 时找不到浏览器算失败而不是跳过
# ORRERY_REQUIRE_BROWSER=
# npm test 同时运行的测试文件数（1～999）；不设时用 Node 的默认值“CPU 数 − 1”，CI 设 4
# ORRERY_TEST_CONCURRENCY=
# npm test 每个测试的时限（毫秒，1000～3600000）；不设时没有每个测试的时限，CI 设 120000
# ORRERY_TEST_TIMEOUT_MS=
# 只由 scripts/ci-checks.ts 读：把 .premerge/checks.json 里每项检查的时限乘上这个数（大于 0、至多 10）；本机合并不受影响
# ORRERY_CHECK_TIMEOUT_SCALE=
# 设为 1 时运行免费的 Codex 真机检查（不调用真实模型）
# ORRERY_CODEX_LIVE=
# 设为 1 时运行桌面版的 Win32 集成检查
# ORRERY_DESKTOP_WIN32=
