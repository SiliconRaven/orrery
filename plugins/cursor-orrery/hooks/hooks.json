{
  "version": 1,
  "hooks": {
    "stop": [
      { "command": "node \"${CURSOR_PLUGIN_ROOT}/hooks/stop.mjs\"", "timeout": 86400, "loop_limit": null }
    ],
    "beforeSubmitPrompt": [
      { "command": "node \"${CURSOR_PLUGIN_ROOT}/hooks/prompt.mjs\"", "timeout": 5 }
    ],
    "postToolUse": [
      { "command": "node \"${CURSOR_PLUGIN_ROOT}/hooks/tool.mjs\"", "timeout": 60, "matcher": "^MCP:" }
    ]
  }
}
