{
  "name": "dsh-orrery",
  "version": "0.10.0-beta.2",
  "description": "Beta release. Connects DeepSeek Harness sessions to a local orrery Hub: group-chat messages arrive as queued user messages, and sessions reply with orrery tools.",
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "lib",
    "locale",
    "cordis.patch.yml",
    "README.md"
  ],
  "engines": {
    "node": ">=24",
    "dsh": ">=0.2.1-rc.2 <0.3.0-0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
