{
  "id": "config-demo",
  "version": "1.0.0",
  "apiVersion": 1,
  "name": "简报格式",
  "description": "设置简报的标题、格式和各群栏目。",
  "entry": "main.mjs",
  "permissions": [],
  "commands": [],
  "config": [
    { "name": "title", "type": "text", "scope": "global", "label": "简报标题", "required": true, "default": "每周简报" },
    { "name": "format", "type": "enum", "scope": "global", "label": "输出格式", "options": ["Markdown", "纯文本"], "default": "Markdown" },
    { "name": "maxItems", "type": "number", "scope": "global", "label": "最多条目", "min": 1, "max": 100, "default": 20 },
    { "name": "directory", "type": "path", "scope": "global", "label": "工作目录" },
    { "name": "showDate", "type": "boolean", "scope": "global", "label": "显示日期", "default": true },
    { "name": "interval", "type": "duration", "scope": "cluster", "label": "汇总间隔", "min": 60, "default": 900 },
    { "name": "owner", "type": "member", "scope": "cluster", "label": "负责人" },
    { "name": "sections", "type": "list", "scope": "cluster", "label": "栏目", "description": "栏目名称须互不相同。", "default": ["进展", "待办"] }
  ]
}
