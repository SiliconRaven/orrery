{
  "id": "tool-demo",
  "version": "1.0.0",
  "name": "工具示例（测试用）",
  "description": "给群员提供两个工具：一个带参数的快工具，一个慢工具。只用于测试，不随产品发布。",
  "apiVersion": 1,
  "entry": "main.mjs",
  "permissions": ["tools.provide", "messages.gate", "messages.read", "events.read"],
  "events": ["message.created"],
  "commands": [
    {"id": "mode", "title": "设置行为（测试探针）", "clusterScoped": false},
    {"id": "calls", "title": "读取收到的调用（测试探针）", "clusterScoped": false},
    {"id": "hold", "title": "过一会儿再回答（测试探针）", "clusterScoped": false}
  ],
  "tools": [
    {
      "name": "echo",
      "description": "Echo a short text back, optionally repeated. Answers at once.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "text": {"type": "string", "description": "The text to echo.", "minLength": 1, "maxLength": 2000},
          "times": {"type": "integer", "description": "How many times.", "minimum": 1, "maximum": 5},
          "loud": {"type": "boolean"},
          "mood": {"type": "string", "enum": ["calm", "happy"]},
          "tags": {"type": "array", "items": {"type": "string", "maxLength": 20}, "maxItems": 5},
          "constructor": {"type": "number", "description": "A property named like an Object method."}
        },
        "required": ["text"],
        "additionalProperties": false
      }
    },
    {
      "name": "slow",
      "description": "Wait the given milliseconds, then answer.",
      "inputSchema": {
        "type": "object",
        "properties": {"ms": {"type": "integer", "minimum": 0, "maximum": 30000}, "note": {"type": "string", "maxLength": 100}},
        "required": ["ms"]
      }
    }
  ]
}
